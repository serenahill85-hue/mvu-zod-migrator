# Public release allowlist. Local records, backups and player files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/STATUS.md
!/THIRD_PARTY.md
!/package.json
!/manifest.json
!/extension.js
!/src/
/src/*
!/src/*.mjs
!/src/vendor/
/src/vendor/*
!/src/vendor/acorn.mjs
!/src/vendor/ACORN-LICENSE.txt
!/tools/
/tools/*
!/tools/build.mjs
!/tests/
/tests/*
!/tests/*.test.mjs
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/schema-global.js
!/tests/fixtures/schema-module.js
!/preview/
/preview/*
!/preview/index.html
!/preview/responsive.html
!/preview/fixture.mjs
!/preview/bundle.js
!/dist/
/dist/*
!/dist/mvu-zod-migrator.json
!/dist/mvu-zod-migrator.js
!/dist/source-manifest.json
!/dist/SHA256SUMS.txt
